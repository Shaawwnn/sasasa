{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "/Users/sasasa/projects/sasasa/hooks/scripts/fmt.sh"
            ],
            "timeout": 20,
            "statusMessage": "Formatting with Prettier"
          },
          {
            "type": "command",
            "command": "bash",
            "args": [
              "/Users/sasasa/projects/sasasa/hooks/scripts/conlog.sh"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "/Users/sasasa/projects/sasasa/hooks/scripts/prurl.sh"
            ],
            "if": "Bash(gh pr create *)",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "/Users/sasasa/projects/sasasa/hooks/scripts/stopaudit.sh"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
